# ──────────────────────────────────────────
# AgriNode Backend – Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Server
PORT=5000

# JWT
JWT_SECRET=agrinode_super_secret_key_change_in_production
JWT_EXPIRES=7d

# CORS – set to your frontend URL in production
ALLOWED_ORIGIN=*

# ── Future MySQL (uncomment when migrating) ──
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=agrinode_user
# DB_PASSWORD=your_password
# DB_NAME=agrinode_db
